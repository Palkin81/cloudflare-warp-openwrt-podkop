#!/bin/sh
# Create an empty, dedicated section. Existing sections are never overwritten.
set -eu
umask 077
. "${WARP_COMMON_LIB:-/usr/libexec/warp-common}"
fail() { printf '{"ok":false,"code":"%s"}\n' "$1"; exit 1; }
[ "${1:-}" = attach ] || fail invalid_action
warp_operation_acquire || fail operation_in_progress
[ -x /etc/init.d/podkop ] || fail podkop_missing
[ -z "$(uci changes)" ] || fail pending_uci_changes
iface=$(uci -q get warp.main.actual_interface) || fail managed_interface_missing
printf '%s' "$iface" | grep -Eq '^[A-Za-z_][A-Za-z0-9_]{0,14}$' || fail invalid_interface_name
[ "$(uci -q get "network.$iface.warp_managed")" = luci-app-warp ] || fail managed_interface_missing
/usr/libexec/warp-probe "$iface" >/dev/null || fail data_plane_unavailable
if uci -q get podkop.cfwarp >/dev/null; then
    [ "$(uci -q get podkop.cfwarp.warp_managed)" = luci-app-warp ] &&
    [ "$(uci -q get podkop.cfwarp.connection_type)" = vpn ] &&
    [ "$(uci -q get podkop.cfwarp.interface)" = "$iface" ] || fail podkop_section_conflict
    printf '{"ok":true,"code":"already_attached"}\n'
    exit 0
fi
# Podkop PE (moz9/podkop-patch-subscriptions, 2026.11.14.x) applies a new section only through its
# own Apply: its reload keeps the admitted runtime ("Saved runtime traffic context differs from
# desired settings; keeping the running service unchanged") and returns 1, so the attach used to
# roll back with podkop_restart_failed. Stock Podkop keeps the plain reload.
podkop_bin=${WARP_PODKOP_BIN:-/usr/bin/podkop}
podkop_has_apply() {
    grep -q '^subscription_config_apply_start()' "$podkop_bin" 2>/dev/null &&
        grep -q '^subscription_config_apply_status()' "$podkop_bin" 2>/dev/null
}
podkop_apply() {
    tries=0
    while :; do
        reply=$("$podkop_bin" subscription_config_apply_start 2>/dev/null) || true
        [ "$(printf '%s' "$reply" | jsonfilter -e '@.success' 2>/dev/null)" = true ] && break
        # another Podkop operation (a background check, a subscription update) holds it: wait
        [ "$(printf '%s' "$reply" | jsonfilter -e '@.error' 2>/dev/null)" = service_busy ] || return 1
        tries=$((tries + 1))
        [ "$tries" -lt 24 ] || return 1
        sleep 5
    done
    waited=0
    while [ "$waited" -lt 300 ]; do
        sleep 3
        waited=$((waited + 3))
        case "$("$podkop_bin" subscription_config_apply_status 2>/dev/null | jsonfilter -e '@.state' 2>/dev/null)" in
        done) return 0 ;;
        failed) return 1 ;;
        esac
    done
    return 1
}
podkop_activate() {
    if podkop_has_apply; then
        # The Apply of Podkop PE refuses to start while the shared Podkop operation lock is held
        # (service_busy), and this attach holds it: the section is committed, so give it back.
        # The Apply serializes itself against other Podkop operations.
        warp_podkop_release
        podkop_apply
    else
        PODKOP_SUBSCRIPTION_CACHE_ONLY=1 PODKOP_SKIP_LIST_UPDATE=1 "$podkop_bin" reload >/dev/null 2>&1
    fi
}
warp_podkop_acquire || fail podkop_busy
trap warp_podkop_release EXIT
work=$(mktemp -d /tmp/warp-podkop.XXXXXX)
committed=0
success=0
cleanup() {
    if [ "$committed" = 1 ] && [ "$success" = 0 ]; then
        # CAS rollback: leave later user changes alone.
        if [ "$(sha256sum /etc/config/podkop | cut -d ' ' -f1)" = "$after" ]; then
            cp "$work/podkop" /etc/config/podkop
            # A failed Apply of Podkop PE keeps the previous runtime: putting the file back is enough.
            podkop_has_apply ||
                PODKOP_SUBSCRIPTION_CACHE_ONLY=1 PODKOP_SKIP_LIST_UPDATE=1 /usr/bin/podkop reload >/dev/null 2>&1 || true
        fi
    fi
    rm -rf "$work"
    warp_podkop_release
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
cp /etc/config/podkop "$work/podkop"
mkdir "$work/uci"
uci -q -t "$work/uci" batch <<EOF
set podkop.cfwarp=section
set podkop.cfwarp.connection_type='vpn'
set podkop.cfwarp.interface='$iface'
set podkop.cfwarp.domain_resolver_enabled='0'
set podkop.cfwarp.user_domain_list_type='disabled'
set podkop.cfwarp.user_subnet_list_type='disabled'
set podkop.cfwarp.mixed_proxy_enabled='0'
set podkop.cfwarp.resolve_real_ip_for_routing='0'
set podkop.cfwarp.warp_managed='luci-app-warp'
EOF
[ -z "$(uci changes)" ] || fail pending_uci_changes
cmp -s "$work/podkop" /etc/config/podkop || fail concurrent_config_change
cp "$work/podkop" /etc/warp/podkop-before-attach.conf
uci -q -t "$work/uci" commit podkop
after=$(sha256sum /etc/config/podkop | cut -d ' ' -f1)
committed=1
podkop_activate || fail podkop_restart_failed
/etc/init.d/sing-box status >/dev/null 2>&1 || fail podkop_restart_failed
nft list table inet PodkopTable >/dev/null 2>&1 || fail podkop_restart_failed
success=1
printf '{"ok":true,"code":"attached"}\n'
